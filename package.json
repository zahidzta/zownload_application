{
  "name": "zownload",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:contracts": "tsc --project tsconfig.contracts.json && node scripts/check-contracts.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "verify:foundation": "powershell -NoProfile -File scripts/verify-foundation.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:debug": "tauri android build --debug --apk --target aarch64 --ci"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
