{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zownload",
  "version": "0.0.1",
  "identifier": "com.zownload.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zownload",
        "width": 420,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 24
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0QjEyNDVDNUVFM0VDNzYKUldSMjdPTmVYQ1N4NU8ramNrcnZnRmphYWF3MkVkUTMvNUtuLzRsMlFYZTdpNTBQYnB2TWEzY3EK",
      "endpoints": [
        "https://github.com/zahidzta/zownload_application/releases/latest/download/latest.json"
      ]
    }
  }
}
