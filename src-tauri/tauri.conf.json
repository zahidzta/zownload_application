{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zownload",
  "version": "0.0.4",
  "identifier": "com.zownload.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zownload",
        "width": 1350,
        "height": 770
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5ODJGRjc0RkUzQTg1RkEKUldUNmhUcitkUCtDYVk0Sys5U0lWRnZ5eTFuVzI2cTNNL0gvZkZNdXJzZ3JIS1ZwQmJMbXM1VU4K",
      "endpoints": [
        "https://github.com/zahidzta/zownload_application/releases/latest/download/latest.json"
      ]
    }
  }
}
